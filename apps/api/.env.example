# Salt for log pseudonyms.
#
# A user id never appears in a log; a stable hash of it does, so an
# operator can see "the same person failed five times" without the log
# carrying the key that indexes that person's career history. Set it per
# environment so a pseudonym from staging says nothing about production.
#
#   node -e "console.log(require('node:crypto').randomBytes(16).toString('hex'))"
#
# Unset is safe - pseudonyms are still stable within the process - but then
# they are comparable across deployments that also have none.
LOG_PSEUDONYM_SALT=

# Which environment this process is. Unset is treated as PRODUCTION - the
# safe assumption, not the convenient one. See src/environment.ts.
# One of: development | test | staging | production
NODE_ENV=development

# API documentation. Served outside production by default and not served in
# production, unless this says otherwise. Only the exact strings "true" and
# "false" count; a typo falls back to the default rather than being read as
# permission to publish the API surface.
# API_DOCS_ENABLED=true

# Browser origins allowed to call the API, comma-separated.
#
# Empty is correct today and is not an omission: the only client is a
# native iOS app, which is not a browser and is not subject to CORS. When a
# web client exists, list its origins here, per environment. A "*" entry is
# filtered out - a wildcard with credentials is the misconfiguration this
# setting exists to prevent, and it must not be reachable from config.
# CORS_ALLOWED_ORIGINS=https://app.example.com

# The Postgres connection string.
#
# TWO REQUIREMENTS THAT ARE EASY TO GET WRONG, both found in PR-1:
#
#   PERCENT-ENCODE the password. A raw %, @, / or : makes the URL invalid
#   to standard parsers - psql rejects it outright - and the failure looks
#   like a connectivity problem rather than an encoding one. Encode with:
#     node -e "console.log(encodeURIComponent(process.argv[1]))" '<password>'
#
#   GENERATE the password; do not choose one. A human-memorable password on
#   a database holding resumes and employment history is not acceptable for
#   production. Generate with:
#     node -e "console.log(require('node:crypto').randomBytes(24).toString('base64url'))"
#
# The credential currently used for local development satisfies neither. It
# is deliberately NOT rotated by PR-3: it is shared with other development
# worktrees, and rotating it from inside this change would break them with
# no warning. PR-6 creates the staging and production projects, and those
# must be created with generated credentials from the start rather than
# rotated afterwards.
DATABASE_URL=
REDIS_URL=redis://localhost:6380
SUPABASE_URL=

# SERVER ONLY. This key bypasses every row-level policy in the project. It
# must never appear in a client bundle, a log line, an API response or a
# commit. Exactly one file reads it (src/auth/supabase.client.ts) and a
# boundary test keeps it that way.
SUPABASE_SERVICE_ROLE_KEY=

# The port the API listens on. Defaults to 3000 when unset.
PORT=3000

# Resume processing worker (Phase 5)
#
# The shared secret the worker sends as x-worker-secret. It is the only
# thing standing between the public internet and a signed URL for every
# resume in the system, so it must be GENERATED, not chosen:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
#
# Unset means the worker endpoints reject everything, which is the correct
# failure and not a reason to leave it blank - the worker simply will not
# run. It was read by the code and absent from this file until PR-2, which
# is exactly the kind of gap that makes a first deployment fail confusingly.
RESUME_WORKER_SECRET=

# Database connection pool (PR-2)
#
# All optional; the defaults in prisma.service.ts are documented there with
# the reasoning for each. They live here because pooling is done by
# node-postgres under the Prisma driver adapter, which means a
# `?connection_limit=` in DATABASE_URL is silently ignored.
#
# DATABASE_POOL_MAX is PER PROCESS. The number the database sees is this
# multiplied by the instance count, and it has to stay under whatever the
# Supabase pooler allows - a limit shared with the worker and with
# migrations. Raising it without checking that moves the failure from our
# pool to theirs.
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_IDLE_TIMEOUT_MS=10000
# Names the connection in pg_stat_activity. Set it per deployment - the
# API, the worker and a migration job should be distinguishable there.
DATABASE_APPLICATION_NAME=career-os-api

# External Evidence Layer (Phase 7)
#
# Keys for encrypting provider credentials at rest, as a JSON object of
# version to base64-encoded 32-byte key. A map rather than a single value
# so a key can be rotated without a big-bang re-encryption: new writes use
# the active version, reads accept any version still listed here, and rows
# migrate as they are touched. Do not remove an old version until every row
# written under it has been re-encrypted.
#
# Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
#
# Example shape (do not use this value):
#   TOKEN_ENCRYPTION_KEYS={"1":"<base64 32 bytes>"}
TOKEN_ENCRYPTION_KEYS=
TOKEN_ENCRYPTION_ACTIVE_KEY_VERSION=1

# GitHub OAuth App (Phase 7.2)
#
# Public repositories only. The requested scope is a constant in code
# (user:email) and is deliberately not configurable: the scopes that would
# widen it - public_repo and repo - are both read/WRITE grants over the
# user's code, and GitHub offers no read-only repository scope.
#
# GITHUB_OAUTH_CALLBACK_URL must exactly match a callback registered on the
# OAuth App, and must be https except on loopback.
# GITHUB_OAUTH_MOBILE_REDIRECT_URI is where the browser is sent afterwards.
# It carries a status only - never a token, code, state or PKCE verifier.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=
#
# This value must EXACTLY match what the mobile app parses, or every user
# finishes GitHub authorisation and is stranded in the browser on a dead
# link - silently, with no error on either side. The app accepts only its
# own scheme and path (see CALLBACK_SCHEME / CALLBACK_PATH in
# apps/mobile/src/github/github-connection.ts) and ignores anything else.
# A web scheme here is refused at startup: it would let our own callback
# redirect a browser mid-OAuth to a remote origin.
GITHUB_OAUTH_MOBILE_REDIRECT_URI=com.careeros.mobile://github/callback
