DATABASE_URL=
REDIS_URL=redis://localhost:6380
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# External Evidence Layer (Phase 7)
#
# Keys for encrypting provider credentials at rest, as a JSON object of
# version to base64-encoded 32-byte key. A map rather than a single value
# so a key can be rotated without a big-bang re-encryption: new writes use
# the active version, reads accept any version still listed here, and rows
# migrate as they are touched. Do not remove an old version until every row
# written under it has been re-encrypted.
#
# Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
#
# Example shape (do not use this value):
#   TOKEN_ENCRYPTION_KEYS={"1":"<base64 32 bytes>"}
TOKEN_ENCRYPTION_KEYS=
TOKEN_ENCRYPTION_ACTIVE_KEY_VERSION=1

# GitHub OAuth App (Phase 7.2)
#
# Public repositories only. The requested scope is a constant in code
# (user:email) and is deliberately not configurable: the scopes that would
# widen it - public_repo and repo - are both read/WRITE grants over the
# user's code, and GitHub offers no read-only repository scope.
#
# GITHUB_OAUTH_CALLBACK_URL must exactly match a callback registered on the
# OAuth App, and must be https except on loopback.
# GITHUB_OAUTH_MOBILE_REDIRECT_URI is where the browser is sent afterwards.
# It carries a status only - never a token, code, state or PKCE verifier.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=
GITHUB_OAUTH_MOBILE_REDIRECT_URI=
