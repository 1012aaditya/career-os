datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum ExperienceType {
  EMPLOYMENT
  FOUNDER
  FREELANCE
  EDUCATION
  VOLUNTEER
  OTHER
}

enum ResumeImportStatus {
  PENDING
  PROCESSING
  NEEDS_REVIEW
  CONFIRMED
  FAILED
}

enum EvidenceSourceType {
  MANUAL
  RESUME
  GITHUB
  PORTFOLIO
  LINKEDIN
  CERTIFICATION
  DOCUMENT
  OTHER
}

/// Which external system an ExternalConnection speaks to. Separate from
/// EvidenceSourceType, which describes where a piece of evidence came from:
/// a source can produce evidence without us ever holding a connection to it
/// (RESUME, MANUAL), and a connection is a credential-bearing relationship
/// that only some sources have.
enum ExternalProvider {
  GITHUB
  PORTFOLIO
}

enum ExternalConnectionStatus {
  ACTIVE
  INVALID
  REVOKED
}

/// PARTIAL is not a failure. A sync that read 30 of 40 repositories
/// succeeded at what it did and must not claim the other 10 were empty -
/// see the completeness contract in docs/external-evidence.
enum ExternalSyncStatus {
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
}

model User {
  id        String   @id @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile               Profile?
  experiences           Experience[]
  projects              Project[]
  userSkills            UserSkill[]
  achievements          Achievement[]
  evidence              Evidence[]
  goals                 Goal[]
  resumeImports         ResumeImport[]
  educations            Education[]
  careerGraphIngestions CareerGraphIngestion[]

  externalConnections        ExternalConnection[]
  oauthAuthorizationRequests OAuthAuthorizationRequest[]
  externalSyncRuns           ExternalSyncRun[]
}

model Profile {
  id        String  @id @default(uuid()) @db.Uuid
  userId    String  @unique @db.Uuid
  firstName String?
  lastName  String?
  headline  String?
  bio       String?
  location  String?
  avatarUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Education {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  institution  String
  location     String?
  degree       String?
  fieldOfStudy String?
  startDate    DateTime?
  endDate      DateTime?
  grade        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  evidence EvidenceEducation[]

  @@index([userId])
  @@index([userId, startDate])
}

model Company {
  id             String  @id @default(uuid()) @db.Uuid
  name           String
  normalizedName String  @unique
  websiteUrl     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  experiences Experience[]
}

model ResumeImport {
  id                   String                @id @default(uuid()) @db.Uuid
  userId               String                @db.Uuid
  fileName             String
  storagePath          String
  status               ResumeImportStatus    @default(PENDING)
  /// What the user reviewed and confirmed. Overwritten by their edits.
  extractionResult     Json?
  /// The worker's original output, written once on delivery and never
  /// updated. Without it there is no way to answer what the AI actually
  /// extracted, because extractionResult is replaced by the user's edits
  /// on every confirm. Null for imports ingested before this column
  /// existed - unknown, and not reconstructible.
  rawExtractionResult  Json?
  errorMessage         String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  careerGraphIngestion CareerGraphIngestion?

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  evidence Evidence[]

  @@index([userId])
  @@index([userId, status])
}

model Experience {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String         @db.Uuid
  companyId   String?        @db.Uuid
  type        ExperienceType
  title       String
  description String?
  location    String?
  startDate   DateTime?
  endDate     DateTime?
  /// The end date exactly as the source wrote it, before parsing.
  /// isCurrent alone cannot distinguish a source that SAID "Present" from
  /// one that simply omitted an end date - the first is a fact, the second
  /// an inference. This keeps that distinction recoverable.
  endDateText String?
  isCurrent   Boolean        @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company      Company?                @relation(fields: [companyId], references: [id], onDelete: SetNull)
  projects     ExperienceProject[]
  skills       ExperienceSkill[]
  achievements ExperienceAchievement[]
  evidence     EvidenceExperience[]

  @@index([userId])
  @@index([companyId])
  @@index([userId, startDate])
}

model Project {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  name        String
  description String?
  url         String?
  startDate   DateTime?
  endDate     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  experiences  ExperienceProject[]
  skills       ProjectSkill[]
  achievements ProjectAchievement[]
  evidence     EvidenceProject[]

  @@index([userId])
  @@index([userId, startDate])
}

model Skill {
  id             String @id @default(uuid()) @db.Uuid
  name           String
  normalizedName String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userSkills  UserSkill[]
  experiences ExperienceSkill[]
  projects    ProjectSkill[]
  evidence    EvidenceSkill[]
}

model UserSkill {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  skillId   String   @db.Uuid
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@index([skillId])
}

model Achievement {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  title       String
  description String?
  occurredAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  experiences ExperienceAchievement[]
  projects    ProjectAchievement[]
  evidence    EvidenceAchievement[]

  @@index([userId])
  @@index([userId, occurredAt])
}

model Evidence {
  id             String             @id @default(uuid()) @db.Uuid
  userId         String             @db.Uuid
  resumeImportId String?            @db.Uuid
  sourceType     EvidenceSourceType
  title          String
  description    String?
  sourceUrl      String?
  externalId     String?
  occurredAt     DateTime?
  capturedAt     DateTime           @default(now())
  metadata       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeImport ResumeImport?         @relation(fields: [resumeImportId], references: [id], onDelete: SetNull)
  experiences  EvidenceExperience[]
  projects     EvidenceProject[]
  skills       EvidenceSkill[]
  achievements EvidenceAchievement[]
  educations   EvidenceEducation[]

  /// Deduplication key for re-syncable sources.
  ///
  /// A resume is confirmed once; an external source is pulled again and
  /// again, so re-ingesting must update in place rather than accumulate a
  /// new row per sync. externalId is nullable and Postgres treats NULLs as
  /// DISTINCT, so every existing resume row - all of which carry NULL - is
  /// unaffected and needs no backfill. NULLS NOT DISTINCT would invert
  /// that and is deliberately not used: it would fail on the second resume
  /// evidence row for a user.
  @@unique([userId, sourceType, externalId])
  @@index([userId])
  @@index([userId, sourceType])
  @@index([userId, capturedAt])
  @@index([resumeImportId])
}

model Goal {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  title       String
  description String?
  targetDate  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, targetDate])
}

model CareerGraphIngestion {
  id             String   @id @default(uuid()) @db.Uuid
  resumeImportId String   @unique @db.Uuid
  userId         String   @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  resumeImport ResumeImport @relation(fields: [resumeImportId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ExperienceProject {
  experienceId String @db.Uuid
  projectId    String @db.Uuid

  experience Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([experienceId, projectId])
  @@index([projectId])
}

model ExperienceSkill {
  experienceId String @db.Uuid
  skillId      String @db.Uuid

  experience Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  skill      Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([experienceId, skillId])
  @@index([skillId])
}

model ProjectSkill {
  projectId String @db.Uuid
  skillId   String @db.Uuid

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([projectId, skillId])
  @@index([skillId])
}

model ExperienceAchievement {
  experienceId  String @db.Uuid
  achievementId String @db.Uuid

  experience  Experience  @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@id([experienceId, achievementId])
  @@index([achievementId])
}

model ProjectAchievement {
  projectId     String @db.Uuid
  achievementId String @db.Uuid

  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@id([projectId, achievementId])
  @@index([achievementId])
}

model EvidenceExperience {
  evidenceId   String @db.Uuid
  experienceId String @db.Uuid

  evidence   Evidence   @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  experience Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@id([evidenceId, experienceId])
  @@index([experienceId])
}

model EvidenceProject {
  evidenceId String @db.Uuid
  projectId  String @db.Uuid

  evidence Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([evidenceId, projectId])
  @@index([projectId])
}

model EvidenceSkill {
  evidenceId String @db.Uuid
  skillId    String @db.Uuid

  evidence Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  skill    Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([evidenceId, skillId])
  @@index([skillId])
}

model EvidenceEducation {
  evidenceId  String @db.Uuid
  educationId String @db.Uuid

  evidence  Evidence  @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  education Education @relation(fields: [educationId], references: [id], onDelete: Cascade)

  @@id([evidenceId, educationId])
  @@index([educationId])
}

model EvidenceAchievement {
  evidenceId    String @db.Uuid
  achievementId String @db.Uuid

  evidence    Evidence    @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@id([evidenceId, achievementId])
  @@index([achievementId])
}

/**
 * ------------------------------------------------------------------
 * EXTERNAL EVIDENCE LAYER (Phase 7)
 * ------------------------------------------------------------------
 * These three tables are additive. Nothing above them changes, and in
 * particular CareerGraphIngestion is left exactly as it is: it is keyed to
 * a ResumeImport by a NOT NULL foreign key, and widening that to carry a
 * source with entirely different semantics - a resume is confirmed once, a
 * connection is re-synced forever - would weaken a live invariant to serve
 * a case that a new table serves without touching anything.
 * See docs/external-evidence/phase-7-0-decisions.md.
 */

/// A credential-bearing relationship between one user and one external
/// provider.
///
/// Identity is the provider's IMMUTABLE numeric account id, never the
/// login. GitHub logins are user-changeable and, once released, claimable
/// by somebody else - so resolving a connection by login is a live
/// cross-user data-leak bug, not a style preference. The login is stored
/// for display and refreshed on each sync.
model ExternalConnection {
  id       String           @id @default(uuid()) @db.Uuid
  userId   String           @db.Uuid
  provider ExternalProvider

  /// The provider's immutable numeric account id, held as text so a
  /// provider whose ids are not numeric can reuse this table.
  externalAccountId    String
  /// Display only. Mutable at the provider; never used as a lookup key.
  externalAccountLogin String

  /**
   * Token material. Nullable because not every provider is
   * credential-bearing: a PORTFOLIO connection is a public URL and holds
   * no token at all.
   * Encrypted with AES-256-GCM. The AAD binds each ciphertext to the user
   * that owns it, so a row copied into another user's record fails to
   * decrypt rather than silently working - without that, anyone able to
   * UPDATE this table could sync as a victim.
   */
  tokenCiphertext Bytes?
  tokenIv         Bytes?
  tokenTag        Bytes?
  /// Which key encrypted this row. Per-row rather than global so rotation
  /// can re-encrypt lazily instead of in one migration.
  tokenKeyVersion Int?
  tokenAlg        String?

  /// What the provider ACTUALLY granted, which can differ from what was
  /// requested. Checked before calling an endpoint, never assumed.
  grantedScopes String[]

  status ExternalConnectionStatus @default(ACTIVE)

  lastVerifiedAt DateTime?
  lastSyncedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  syncRuns ExternalSyncRun[]

  /// One connection per provider per user.
  @@unique([userId, provider])
  /// One user per external account. This is what caps the blast radius of
  /// an account-linking CSRF: a successful attack becomes a unique-
  /// constraint conflict instead of one attacker account silently
  /// attached to many victims.
  @@unique([provider, externalAccountId])
}

/// A pending OAuth authorization, created before the user is sent to the
/// provider and consumed exactly once when they come back.
///
/// This table is the ONLY thing that answers "which of our users does this
/// callback belong to". The callback arrives in a system browser that
/// carries no session for a bearer-token API, so there is no ambient user
/// to read - which is the correct design, not a limitation. Deriving the
/// owner from a session instead is the account-linking CSRF: an attacker
/// authorizes as themselves, withholds the callback, and induces a
/// logged-in victim to replay it, binding the attacker's provider account
/// to the victim's profile.
model OAuthAuthorizationRequest {
  id       String           @id @default(uuid()) @db.Uuid
  userId   String           @db.Uuid
  provider ExternalProvider

  /// sha256(state), never the state itself. A read-only leak of this table
  /// then yields nothing replayable.
  stateHash String @unique

  /// PKCE verifier, encrypted at rest like any other credential. It is
  /// short-lived, but a verifier in the clear turns a leaked authorization
  /// code back into a redeemable one.
  codeVerifierCiphertext Bytes
  codeVerifierIv         Bytes
  codeVerifierTag        Bytes
  codeVerifierKeyVersion Int

  /// Recorded so the callback can verify the URI it arrived on matches the
  /// one the request went out with.
  redirectUri String
  /// The scope string actually sent. Always sent explicitly: omitting it
  /// makes the provider grant every scope the user ever approved for this
  /// application.
  scope       String

  expiresAt  DateTime
  /// Set by an atomic compare-and-swap. A second consumption is an attack
  /// signal, not a retry.
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// The source-generic ingestion ledger: one row per sync attempt.
///
/// stats carries the completeness record - reposScanned, reposTotal and
/// the per-repository markers. A run that read fewer repositories than it
/// found is PARTIAL. It must never be reported as SUCCEEDED, because a
/// repository that was skipped for rate-limit budget is not a repository
/// with no work in it.
model ExternalSyncRun {
  id           String             @id @default(uuid()) @db.Uuid
  connectionId String             @db.Uuid
  userId       String             @db.Uuid
  status       ExternalSyncStatus @default(RUNNING)

  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  errorMessage String?
  stats        Json?

  connection ExternalConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([connectionId, startedAt])
  @@index([userId])
}

/**
 * ---------------------------------------------------------------------
 * PHASE 8 - MARKET GRAPH
 * ---------------------------------------------------------------------
 * The Career Graph above answers "what does this person know and have
 * evidence for". Everything below answers a different question - "what are
 * employers currently advertising" - and the two must not be able to
 * answer each other's.
 * Advertising, deliberately, and not "demand". A posting is an
 * advertisement: evergreen pipeline reqs, roles already filled internally,
 * and one requisition advertised in three cities are all postings and none
 * of them is an opening. Naming the thing we actually observe is what
 * stops a demandIndex column growing here later.
 * Every model here is additive and prefixed Market. Nothing above is
 * altered: no column added, no constraint changed, no row read or
 * rewritten. The prefix is load-bearing rather than cosmetic - it makes
 * "did Phase 8 touch a frozen table?" answerable by grep instead of by
 * review.
 * NOTHING here has a foreign key into User, Skill, UserSkill, Experience,
 * Project or Evidence. That absence IS the phase boundary between market
 * observation and the Opportunity Engine, and a test fails if a relation
 * ever appears. Market skills are deliberately not Career Graph Skill
 * rows: Skill.normalizedName is globally unique across all users, its
 * display name is permanently the first importer's spelling, and inserts
 * take an index lock held to commit - so a background market ingest
 * writing there would both serialise against live resume imports and
 * silently edit users' career graphs.
 * See docs/market-graph/phase-8-0-decisions.md.
 */

/// What a source supplies. A source that supplies a vocabulary is not a
/// source that supplies observations, and a taxonomy pull must never
/// invent postings to fit itself through the ingestion pipeline.
enum MarketSourceKind {
  JOB_BOARD
  SKILL_TAXONOMY
}

/// On what basis we believe we may store and aggregate this source's data.
///
/// UNADDRESSED_PUBLIC_ENDPOINT is the honest description of a documented,
/// unauthenticated, third-party-facing API with no terms of service
/// governing it. It is NOT a grant, and recording it as its own value
/// rather than as an absence keeps the distinction queryable instead of
/// remembered. Adzuna is the counter-example that motivates the column:
/// its terms name aggregation into vacancy counts in the prohibited list.
enum MarketLicenceBasis {
  UNADDRESSED_PUBLIC_ENDPOINT
  EXPLICIT_GRANT
  CONTRACTED
}

/// PARTIAL is not a failure - the same contract as ExternalSyncStatus. A
/// run that read 3 of 10 boards succeeded at what it did and must not
/// claim the other 7 were empty. Deliberately a separate enum: reusing
/// ExternalSyncStatus would couple two lifecycles, and that one is frozen.
enum MarketIngestionStatus {
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
}

/// A computation either ran or it did not.
///
/// Separate from MarketIngestionStatus for the same reason that enum is
/// separate from ExternalSyncStatus - and because PARTIAL has no meaning
/// for a computation. Whether the DATA underneath was partial is a
/// different question, answered by MarketSignalRun.coverageComplete.
enum MarketComputationStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

/// How a posting's identity was derived. The basis is falsifiable even
/// where the identity is not - the same reason Phase 7 records
/// revalidatedBy. A source that supplies no stable id gets a weaker basis
/// and its collision risk is documented at that point, not assumed away.
enum MarketIdentityBasis {
  SOURCE_ID
  SOURCE_URL
  CONTENT_FINGERPRINT
}

/// Whether the source gave us the whole posting body.
///
/// Load-bearing for denominators, not decoration. A truncated description
/// systematically undercounts skills, so mixing truncated and full
/// postings in one prevalence denominator produces a number that is about
/// our fetch strategy rather than about the market.
enum MarketDescriptionCompleteness {
  FULL
  TRUNCATED
  ABSENT
}

/// NO_TEXT is not "no skills". It is the NOT_SCANNED rule applied to
/// denominators: a posting we could not read is not a posting with no
/// requirements, and it is excluded from the prevalence denominator
/// rather than counted as a zero.
enum MarketSkillExtractionStatus {
  EXTRACTED
  NO_TEXT
  FAILED
}

/// Which deterministic path produced a mapping. All four are replayable
/// from the alias table; none is a probability. UNMAPPED is a first-class
/// retained outcome - an unrecognised term keeps its row so the raw term
/// is never discarded, and the set of unmapped terms ranked by frequency
/// is the curation backlog.
enum MarketTermMatchMethod {
  EXACT_CANONICAL
  ALIAS
  SOURCE_TAXONOMY
  UNMAPPED
}

/// Where in the posting a term was found. A skill in a source's own
/// structured taxonomy is a different quality of observation from one
/// matched in prose, and without this field the two are silently averaged.
enum MarketTermLocus {
  TITLE
  DESCRIPTION
  SOURCE_TAXONOMY
}

/// Measurable statements only. There is deliberately no DEMAND_SCORE.
enum MarketSignalType {
  ROLE_POSTING_VOLUME
  ROLE_SKILL_PREVALENCE
}

/// Whether cross-source duplicates were collapsed before counting.
///
/// An enum rather than free text because this is the field that decides
/// whether a count may be called "jobs" or only "postings", and 'none'
/// silently failing to equal 'NONE' would defeat every consumer guard.
enum MarketDedupeMethod {
  NONE
}

/// One external system we read market observations from.
///
/// One row per adapter FAMILY, not per company board. Greenhouse is one
/// source; the board token is a sub-scope carried on each posting. The
/// alternative - a source row per board - would make distinctSourceCount
/// and distinctCompanyCount the same number and quietly destroy the only
/// signal that tells a reader a "market" statistic came from one employer.
model MarketSource {
  id   String @id @default(uuid()) @db.Uuid
  /// Authored, immutable, ASCII, and CHECK-constrained in the migration to
  /// ^[a-z0-9][a-z0-9-]*$. Identity is scoped by this and never by `id`:
  /// `id` is a uuid that differs between dev, CI and production, so a
  /// derived posting id containing one would not be reproducible across
  /// environments - the determinism tests would pass in-process and the
  /// artifact would still be machine-local.
  slug String @unique

  displayName   String
  kind          MarketSourceKind    @default(JOB_BOARD)
  /// The best identity this source can support. Changing it is an adapter
  /// version bump, never a silent re-keying of existing rows.
  identityBasis MarketIdentityBasis @default(SOURCE_ID)

  licenceBasis      MarketLicenceBasis
  /// What was actually read, and when. Without these,
  /// EXPLICIT_GRANT and CONTRACTED are assertions rather than findings.
  licenceNote       String?
  licenceReviewedAt DateTime?

  /// Defaults to FALSE, and that is deliberate.
  ///
  /// The licence position is the one dimension Phase 8 admits is
  /// unresolved, so the schema must not fail open on it. Enabling a source
  /// is an explicit act by somebody who has looked, not a consequence of
  /// inserting a row.
  isEnabled Boolean @default(false)

  /// Whether aggregates derived from this source may be shown outside the
  /// team. Separate from isEnabled because ingesting for internal analysis
  /// and publishing to users are different permissions, and a source may
  /// well allow the first and not the second.
  mayRedistributeDerived Boolean @default(false)

  /// How long a posting on this source is expected to stay live. Feeds
  /// freshness, which is DERIVED and never stored. The default of 30 days
  /// is the modal auto-expiry on major ATS boards - defensible as board
  /// behaviour, not as a measured market median. Every freshness verdict
  /// RETURNS the basis it used, so a verdict resting on this guess is
  /// identifiable at the point it is read.
  expectedPostingLifetimeDays Int @default(30)
  /// Feeds the FRESH threshold at two intervals, so one missed run does
  /// not flip a healthy posting. A statement about our sampling, not about
  /// the job market, which is why it needs no market evidence.
  pollIntervalHours           Int @default(24)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  runs          MarketIngestionRun[]
  postings      MarketPosting[]
  scopeCoverage MarketRunScopeCoverage[]
  datasets      MarketDatasetVersion[]
}

/// One row per ingestion attempt. The source-generic ledger, modelled on
/// ExternalSyncRun - including the partial unique index that one lacks,
/// and the stale-run lease that makes such an index safe to add.
model MarketIngestionRun {
  id       String                @id @default(uuid()) @db.Uuid
  sourceId String                @db.Uuid
  status   MarketIngestionStatus @default(RUNNING)

  /// A monotonic, environment-independent ordinal.
  ///
  /// Exists because uuid primary keys cannot break a tie. Two sightings of
  /// one posting can share an observedAt millisecond, and the only other
  /// unique column available is a uuid4 - which is total but arbitrary and
  /// DIFFERENT between dev, CI and production. Ordering by it would
  /// reproduce, one layer down, exactly the defect that keeps `id` out of
  /// derived posting identities.
  runSeq Int @unique @default(autoincrement())

  /// Stamped at open, immutable. A re-parse under a later adapter is then
  /// a checkable difference rather than an invisible one.
  adapterVersion Int
  rulesetVersion Int

  /// The exact request this run made, and its hash. Load-bearing: "62 of
  /// 100 sampled postings" is meaningless unless what the sample was drawn
  /// from is recorded. The fingerprint is what makes a sample reproducible
  /// and what reveals that two runs believed comparable asked different
  /// questions.
  queryParams      Json
  queryFingerprint String

  startedAt   DateTime
  finishedAt  DateTime?
  /// A short, already-sanitized code. Callers pass a reason, never a
  /// caught error.
  errorReason String?
  /// A convenience summary. NOT the basis for the run's status - that is
  /// derived from MarketRunScopeCoverage rows, because a status derived
  /// from a caller-supplied block is only as good as the caller, and the
  /// caller is the code most motivated to believe its run went well.
  stats       Json?

  source        MarketSource             @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  scopeCoverage MarketRunScopeCoverage[]
  sightings     MarketPostingSighting[]
  versions      MarketPostingVersion[]

  @@index([sourceId, startedAt])
  @@index([queryFingerprint])
}

/// What one run actually covered, per scope. Append-only.
///
/// This table is why freshness can be derived without a sweeper.
///
/// The alternative was a lastCompleteCoverageAt column on every posting,
/// which cannot work: the only code that touches a posting row is the
/// ingest path, and the ingest path only touches postings it SAW. A
/// posting that has disappeared from a board would never have the column
/// advanced, so it would report "we cannot tell" forever and the states
/// that exist to describe a closed job would be unreachable. Advancing it
/// in bulk instead would mean rewriting rows nothing observed - the exact
/// write churn that is the reason freshness is derived in the first place.
///
/// One ~50-byte row per run per scope answers it with neither: "was this
/// scope completely read since we last saw that posting" is a MAX over
/// this table.
model MarketRunScopeCoverage {
  runId       String @db.Uuid
  sourceId    String @db.Uuid
  sourceScope String

  /// We intended to read it. Always true today; a source that discovers
  /// its own scopes could record one it found but chose not to read.
  requested        Boolean @default(true)
  /// The fetch completed and we know what is in this scope.
  read             Boolean
  /// Everything in the scope was read, not just some pages of it.
  ///
  /// A 404 sets this false, NOT "read, zero postings". The 404 body is
  /// byte-identical for a mistyped token, a renamed board and a genuinely
  /// retired one, so reading it as "this employer has no jobs" would close
  /// every posting on that board overnight on the strength of a typo.
  /// Fails closed.
  completeForScope Boolean

  /// Short stable code. Never a caught error.
  failureReason String?

  postingsSeen      Int @default(0)
  postingsAccepted  Int @default(0)
  postingsRejected  Int @default(0)
  duplicatesDropped Int @default(0)

  finishedAt DateTime?

  run    MarketIngestionRun @relation(fields: [runId], references: [id], onDelete: Restrict)
  source MarketSource       @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@id([runId, sourceScope])
  @@index([sourceId, sourceScope, completeForScope, finishedAt])
}

/// WHO a posting is. Identity only, plus the one fact about our own
/// observation of it that is allowed to move.
model MarketPosting {
  id       String @id @default(uuid()) @db.Uuid
  sourceId String @db.Uuid

  /// Opaque. Compared and looked up, NEVER parsed - a scope may contain a
  /// separator even where a slug may not, so parsing is ambiguous by
  /// construction. Every component a query needs is also its own column.
  ///
  ///   market:<sourceSlug>:<basis>:<identityVersion>:<scope>/<externalKey>
  ///
  /// identityVersion is inside the string so that changing a derivation
  /// produces a visible split rather than silently re-identifying
  /// everything ingested afterwards.
  externalId String @unique

  identityBasis   MarketIdentityBasis
  identityVersion Int
  /// The source's own key, verbatim.
  externalKey     String
  /// The sub-scope within the source this posting was found in: a board
  /// token for an ATS, a country for an aggregator, '*' for a source with
  /// no sub-scope. Part of identity, so a source's scope DEFINITION is
  /// frozen at first ingest - changing it is an identityVersion bump with
  /// an expected, labelled split, not a silent re-keying.
  sourceScope     String

  /// The grouping the SOURCE itself asserts, where it asserts one.
  ///
  /// Greenhouse returns both a job-post id and a requisition id, and one
  /// requisition advertised in three cities is three posts sharing one
  /// requisition. Volume counts posts, so it overcounts openings. Storing
  /// the key the source already gives us makes "posts or openings" a
  /// choice a later phase can make; discarding it makes that choice
  /// impossible without a re-fetch that will fail, because the source
  /// deletes its postings.
  externalGroupKey String?

  /// Immutable. Appears in no update payload, so a re-observation can
  /// never overwrite when we first saw this job.
  firstSeenAt DateTime
  /// Advances by GREATEST(old, new) only, and only when a sighting row is
  /// actually inserted. Never advanced by a migration, a backfill or a
  /// re-normalization - that is the whole anti-fabrication rule, and
  /// Phase 7 has already been bitten by its violation.
  lastSeenAt  DateTime

  /// Denormalized for cross-source work that Phase 8 deliberately does not
  /// do. Stored now because a source deletes its postings and the future
  /// job would otherwise need a re-fetch that can no longer succeed.
  ///
  /// NOT authoritative and never counted. companyNormalized here carries
  /// no ruleset stamp, so it cannot answer "under which rules?"; every
  /// count of distinct employers reads
  /// MarketPostingNormalization.companyNormalized at the signal's own
  /// ruleset version instead. This is a lookup accelerator, nothing more.
  companyRaw        String?
  companyNormalized String?
  applyUrlCanonical String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  source         MarketSource                 @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  versions       MarketPostingVersion[]
  sightings      MarketPostingSighting[]
  /// At most one. Derived, and rebuilt rather than edited.
  searchDocument MarketPostingSearchDocument?

  @@index([sourceId, sourceScope])
  @@index([sourceId, firstSeenAt])
  @@index([sourceId, externalGroupKey])
  @@index([companyNormalized])
}

/// WHAT a posting said. Immutable and content-addressed.
///
/// A re-fetch whose content hash matches creates no row here; an edited
/// posting creates exactly one new one, and the old is retained so a
/// signal computed last month still resolves to the text that produced it.
model MarketPostingVersion {
  id        String @id @default(uuid()) @db.Uuid
  postingId String @db.Uuid

  /// Which hashing rule produced contentHash.
  ///
  /// In the uniqueness key, so that fixing the entity decoder or changing
  /// the hashed field list produces a LABELLED split rather than a
  /// simultaneous phantom edit to every posting ever ingested.
  contentHashVersion Int
  /// Hash of the fields this system reads - NOT of the whole payload.
  ///
  /// The exclusion is the load-bearing part. Greenhouse varies its key set
  /// between boards, so hashing the payload would mint a new version for
  /// every posting on a board the day the vendor adds a field - recording
  /// an API change as a market event, and degrading this table into one
  /// row per fetch, which is the model it exists to avoid.
  ///
  /// sourceUpdatedAt is excluded for the same reason: an ATS bumps it when
  /// a recruiter touches a req, with the advertised text byte-identical,
  /// and a 20KB version per internal edit is not a record of the market.
  /// The source's claim is kept per-observation on the sighting instead.
  contentHash        String

  firstSeenRunId String   @db.Uuid
  firstSeenAt    DateTime

  titleRaw                String
  companyRaw              String?
  locationRaw             String?
  /// Verbatim, HTML and all. Never tidied - the cleaned form lives on the
  /// normalization row, which is versioned and re-derivable. This is not.
  descriptionRaw          String?
  descriptionCompleteness MarketDescriptionCompleteness

  /// The source's claims about time, never ours. Null means the source did
  /// not say - never now(), never a sibling field. An invented date is
  /// worse than an absent one.
  sourcePublishedAt  DateTime?
  /// The source's claim AS OF THE OBSERVATION THAT FIRST PRODUCED THIS
  /// CONTENT. It is not refreshed, because this row is immutable; the
  /// current claim is on the latest sighting.
  sourceUpdatedAt    DateTime?
  /// Would be the ideal freshness input - it is the employer's own stated
  /// expiry rather than our guess. Greenhouse returned null for it on all
  /// 864 postings sampled, so it is parsed and stored and NOTHING depends
  /// on it being present.
  sourceValidThrough DateTime?

  applyUrlRaw         String?
  /// The source's own taxonomy labels, verbatim and unmapped.
  ///
  /// An array because the sources have arrays: Greenhouse returns
  /// departments and offices, USAJOBS a coded category list. A singular
  /// column could only be filled by picking element zero, which would make
  /// the value depend on the source's array order - and that order is
  /// explicitly not trusted anywhere else in this design. Ordered by the
  /// adapter before storage, so it is stable under a reshuffle.
  ///
  /// These are NOT roles. "Engineering" is far coarser than a canonical
  /// role and mapping it would collapse every discipline into one
  /// denominator.
  sourceCategoriesRaw String[]
  /// Which occupational classification sourceCategoriesRaw is expressed
  /// in, as the adapter declared it: "noc", "opm-series", "ssyk-label".
  /// A taxonomy name, never a source name - stored with the observation
  /// because normalization must be able to read a code's scheme without
  /// learning which source supplied it.
  occupationScheme    String?

  /// The source's response for this posting, preserved. NOT NULL: without
  /// it nothing is reproducible once the source deletes the posting, and a
  /// nullable column makes that guarantee optional.
  rawPayload     Json
  rawPayloadHash String

  createdAt DateTime @default(now())

  posting         MarketPosting                 @relation(fields: [postingId], references: [id], onDelete: Cascade)
  firstSeenRun    MarketIngestionRun            @relation(fields: [firstSeenRunId], references: [id], onDelete: Restrict)
  sightings       MarketPostingSighting[]
  normalizations  MarketPostingNormalization[]
  searchDocuments MarketPostingSearchDocument[]

  @@unique([postingId, contentHashVersion, contentHash])
  @@index([postingId])
  @@index([firstSeenRunId])
}

/// THAT we saw it. Append-only, one narrow row per (run, posting, version).
///
/// This is the ledger that lets "we looked again" be recorded without
/// touching anything that would fabricate freshness, and it is what signal
/// windows filter on.
model MarketPostingSighting {
  runId     String @db.Uuid
  postingId String @db.Uuid
  versionId String @db.Uuid

  /// When the response carrying this posting was received, on our clock.
  /// Varies WITHIN a run - a walk over many boards spans minutes - which
  /// is why it is not the same field as capturedAt.
  observedAt DateTime
  /// The run clock: identical on every row a run writes. The batch key,
  /// and the field excluded from change detection.
  capturedAt DateTime
  /// Denormalized from the run so that (observedAt, runSeq) is a total
  /// order over a posting's sightings without a join. Millisecond
  /// timestamps tie; this is what breaks the tie reproducibly.
  runSeq     Int

  /// What the source claimed about its own last update AT THIS
  /// OBSERVATION. Deliberately here rather than only on the version:
  /// excluding it from the content hash is what stops an internal ATS
  /// touch minting a 20KB version, and keeping it here is what stops that
  /// exclusion losing the information.
  sourceUpdatedAt DateTime?

  /// Where in the walk this arrived, so "first occurrence wins" dedupe is
  /// reconstructible rather than merely asserted.
  pageIndex   Int
  indexInPage Int

  createdAt DateTime @default(now())

  run     MarketIngestionRun   @relation(fields: [runId], references: [id], onDelete: Restrict)
  posting MarketPosting        @relation(fields: [postingId], references: [id], onDelete: Cascade)
  version MarketPostingVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  /// versionId is in the key so that a paginated source which legitimately
  /// returns one posting twice in a walk, with an edit between the two
  /// pages, can record both. Keyed on (run, posting) alone, the second
  /// insert would collide and the second version would exist with no
  /// sighting - invisible to every signal, because windows filter on
  /// sightings.
  @@id([runId, postingId, versionId])
  @@index([observedAt])
  @@index([postingId, observedAt, runSeq])
  @@index([versionId])
}

/// A canonical role in the MARKET vocabulary. Not a job title a user holds.
///
/// Opaque uuid primary key plus an authored, immutable, unique slug. The
/// slug carries the determinism (derived artifacts reference it, not the
/// uuid); the uuid carries the mutability, so a label can be corrected
/// without a cascade rewrite of every row that ever referenced the role.
///
/// Slugs are hand-authored rather than generated because slugification is
/// locale- and Unicode-dependent: 'C++' and 'C#' both collapse to 'c'
/// under a naive strip, which would give two distinct entities one key.
model MarketRole {
  id    String @id @default(uuid()) @db.Uuid
  slug  String @unique
  label String

  introducedInRulesetVersion Int
  /// Roles are never deleted. A retired role keeps its id so historical
  /// signals still resolve; new resolutions route elsewhere.
  deprecatedAt               DateTime?
  supersededById             String?   @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  supersededBy MarketRole?  @relation("MarketRoleSupersession", fields: [supersededById], references: [id], onDelete: Restrict)
  supersedes   MarketRole[] @relation("MarketRoleSupersession")

  aliases        MarketRoleAlias[]
  normalizations MarketPostingNormalization[]
  signals        MarketSignal[]

  @@index([supersededById])
}

/// A canonical skill in the MARKET vocabulary.
///
/// Deliberately NOT the Career Graph's Skill. That table is a user-facing
/// vocabulary with a globally unique name and a first-writer-wins display
/// string; this one holds a market vocabulary that has no business in a
/// user's skill picker. Phase 9 links them with an explicit mapping table,
/// never with a shared row.
model MarketSkill {
  id    String @id @default(uuid()) @db.Uuid
  slug  String @unique
  label String

  introducedInRulesetVersion Int
  deprecatedAt               DateTime?
  supersededById             String?   @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  supersededBy MarketSkill?  @relation("MarketSkillSupersession", fields: [supersededById], references: [id], onDelete: Restrict)
  supersedes   MarketSkill[] @relation("MarketSkillSupersession")

  aliases  MarketSkillAlias[]
  mentions MarketPostingSkillMention[]
  signals  MarketSignal[]

  @@index([supersededById])
}

/// The RULE: a normalized title resolves to a canonical role.
///
/// Curatable, keyed by ruleset version. Separate from the DECISION
/// recorded on MarketPostingNormalization, which is frozen - so correcting
/// a rule tomorrow does not retroactively change what we decided today.
model MarketRoleAlias {
  id              String @id @default(uuid()) @db.Uuid
  rulesetVersion  Int
  /// The lookup key, already NFKC-folded and casefolded.
  aliasNormalized String
  roleId          String @db.Uuid

  createdAt DateTime @default(now())

  role           MarketRole                   @relation(fields: [roleId], references: [id], onDelete: Restrict)
  normalizations MarketPostingNormalization[]

  /// An alias resolves to exactly one role within a ruleset. Ambiguity is
  /// a curation decision made once here, never re-litigated per posting.
  @@unique([rulesetVersion, aliasNormalized])
  @@index([roleId])
}

/// The RULE: a normalized term resolves to a canonical skill.
model MarketSkillAlias {
  id              String @id @default(uuid()) @db.Uuid
  rulesetVersion  Int
  aliasNormalized String
  skillId         String @db.Uuid

  createdAt DateTime @default(now())

  skill    MarketSkill                 @relation(fields: [skillId], references: [id], onDelete: Restrict)
  mentions MarketPostingSkillMention[]

  @@unique([rulesetVersion, aliasNormalized])
  @@index([skillId])
}

/// What WE read a posting version to say, under one ruleset version.
///
/// Append-only and keyed by version, so re-normalizing under v2 writes new
/// rows and a v1 signal stays reproducible and explainable. There is
/// deliberately no "current" pointer: every read names its ruleset
/// version, which dissolves the problem rather than solving it with a
/// mutable flag.
model MarketPostingNormalization {
  id             String @id @default(uuid()) @db.Uuid
  versionId      String @db.Uuid
  rulesetVersion Int

  titleNormalized String
  /// Null means the title did not resolve. The posting is retained and
  /// counted in the gap report; it is never dropped, and it is never
  /// force-mapped to the nearest-looking role. A CHECK ties this to
  /// roleMatchMethod, so "unmapped but has a role" is unrepresentable.
  roleId          String?               @db.Uuid
  roleMatchMethod MarketTermMatchMethod
  roleAliasId     String?               @db.Uuid

  /// The token the title parser removed from the head or tail - "senior",
  /// "staff", "ii".
  ///
  /// Named for what it IS rather than for what we think it means. Calling
  /// it seniority would assert that our classification of "II" is a fact
  /// about the posting, and no source in scope asserts seniority at all.
  /// The value is verbatim, so the evidence for a seniority ontology
  /// accumulates without one being presumed.
  titleModifierRaw String?

  companyNormalized String?
  /// Entity-unescaped, tag-stripped, whitespace-collapsed body text.
  descriptionText   String?

  skillExtractionStatus MarketSkillExtractionStatus
  /// canonicalHash of everything this row asserts, INCLUDING its skill
  /// mentions in sorted order. Re-normalizing must reproduce it, and the
  /// comparison is an explicit read-and-compare rather than a reliance on
  /// the unique constraint: a unique violation says "a row exists", not
  /// "the normalizer is deterministic", and mentions live in another table
  /// where a hash over this row alone would never notice them.
  outputHash            String

  normalizedAt DateTime

  version   MarketPostingVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  role      MarketRole?          @relation(fields: [roleId], references: [id], onDelete: Restrict)
  roleAlias MarketRoleAlias?     @relation(fields: [roleAliasId], references: [id], onDelete: Restrict)

  mentions MarketPostingSkillMention[]

  @@unique([versionId, rulesetVersion])
  /// The target of the mentions' composite foreign key, which is what
  /// makes a mention keyed to a different ruleset than its own
  /// normalization unrepresentable. Without it, a half-finished
  /// re-normalization could put a mention in v2's numerator while its
  /// posting sits in v1's denominator, and prevalence would exceed 100%
  /// with nothing in the system able to notice.
  @@unique([id, rulesetVersion])
  @@index([rulesetVersion, roleId])
  @@index([roleId])
  @@index([roleAliasId])
}

/// The DECISION, frozen: this posting mentioned this raw term, and this is
/// what we mapped it to and why.
///
/// This table is what answers "why did Shipaton map 'Postgres' to
/// PostgreSQL?". rawTerm is NOT NULL and skillId IS nullable, so an
/// unmapped term keeps its row rather than being discarded.
///
/// Honest scope of that guarantee: UNMAPPED here is reachable only from
/// the SOURCE_TAXONOMY locus - a source that hands us an explicit skills
/// array containing a term the dictionary does not know. It is NOT
/// reachable from prose, because nothing in Phase 8 decides which words in
/// a description were meant to be skills; extraction is dictionary
/// matching, so a term we do not know is a term we never saw. Greenhouse
/// supplies no skills array, so this column is null-free today and such
/// rows will start appearing with the first source that has one.
///
/// The curation backlog that IS real in Phase 8 is the unresolved TITLE:
/// MarketPostingNormalization.titleNormalized where roleId IS NULL,
/// grouped and ranked. Discovering unknown skill terms in prose needs a
/// candidate extractor that has deliberately not been built.
model MarketPostingSkillMention {
  id              String @id @default(uuid()) @db.Uuid
  normalizationId String @db.Uuid
  /// Always equal to the parent's, and enforced by a composite foreign key
  /// rather than by convention. See the note on the parent's @@unique.
  rulesetVersion  Int

  /// The exact source string. Never null, never tidied.
  rawTerm        String
  termNormalized String
  /// Null = observed but unmapped. Not "no skill". A CHECK ties this to
  /// matchMethod.
  skillId        String? @db.Uuid
  aliasId        String? @db.Uuid

  matchMethod   MarketTermMatchMethod
  extractedFrom MarketTermLocus

  createdAt DateTime @default(now())

  normalization MarketPostingNormalization @relation(fields: [normalizationId, rulesetVersion], references: [id, rulesetVersion], onDelete: Cascade)
  skill         MarketSkill?               @relation(fields: [skillId], references: [id], onDelete: Restrict)
  alias         MarketSkillAlias?          @relation(fields: [aliasId], references: [id], onDelete: Restrict)

  /// One posting mentioning "Postgres" three times yields one row. There
  /// is deliberately no occurrence count: a skill named ten times in a
  /// verbose posting is not more required than one named once, and
  /// counting occurrences would turn prose style into a market signal.
  @@unique([normalizationId, termNormalized, extractedFrom])
  @@index([skillId, rulesetVersion])
  @@index([rulesetVersion])
  @@index([aliasId])
}

/// One computation of the market graph. The identity of a snapshot.
///
/// Without this table "the market graph as of last Tuesday" is a fuzzy
/// timestamp range instead of an id, and Phase 9 can cite a signal but not
/// the snapshot it came from.
model MarketSignalRun {
  id     String                  @id @default(uuid()) @db.Uuid
  status MarketComputationStatus @default(RUNNING)

  rulesetVersion     Int
  computationVersion Int

  /// Half-open [start, end) in UTC, filtered on the sighting's observedAt.
  /// Half-open so adjacent windows tile with no double count at the seam.
  windowStart DateTime
  windowEnd   DateTime

  /// The scopes this run drew from, and their checksum.
  ///
  /// The list is stored, not just the key. A signal that carries only an
  /// opaque hash cannot answer "which employers is this about?", which is
  /// the single claim the honesty rule rests on - every signal is "the
  /// market as covered by these employers", and that is unenforceable if
  /// the employers are unrecoverable.
  sourceScopeKey String
  scopes         String[]

  /// The publication floor. On the run rather than in code, so changing it
  /// produces a new comparable snapshot instead of silently changing what
  /// an existing number means.
  minDenominator       Int
  minDistinctCompanies Int

  /// False when any run intersecting the window failed to completely cover
  /// one of THIS run's scopes. Scoped, not global: a signal over
  /// {vercel, stripe} must not be flagged because an unrelated board
  /// 404'd, or the flag becomes noise nobody reads.
  coverageComplete Boolean @default(false)

  computedAt DateTime
  finishedAt DateTime?
  /// Exclusion and suppression counts, so the gap between what was
  /// observed and what was published is visible.
  stats      Json?

  signals MarketSignal[]

  @@index([computedAt])
  @@index([windowStart, windowEnd])
}

/// A measurable statement about what employers are advertising. Immutable
/// and append-only: a recompute writes a new run and a fresh set of rows.
///
/// There is deliberately NO value, ratio, percent, score, weight or
/// confidence column. The ratio is numeratorCount / denominatorCount,
/// derived at read. Storing the float would detach the number from its
/// sample - 3/7 and 429/1001 both round to 0.4286 and only one is a signal
/// - and it is the exact surface on which an undefendable "demand score"
/// grows.
///
/// This is also the role-skill relationship. There is no MarketRoleSkill
/// edge table, because "Backend Engineer requires TypeScript" is not a
/// fact anyone observed; it is a computed statement with a numerator, a
/// denominator, a window and a ruleset version, and an edge table is that
/// statement with its provenance thrown away.
model MarketSignal {
  id         String           @id @default(uuid()) @db.Uuid
  runId      String           @db.Uuid
  signalType MarketSignalType

  roleId  String  @db.Uuid
  /// Null for ROLE_POSTING_VOLUME. Postgres treats NULLs as DISTINCT, so
  /// this column cannot appear in an @@unique - two partial unique indexes
  /// are created in the migration instead.
  skillId String? @db.Uuid

  /// Both signal types carry a real denominator, and neither is trivially
  /// equal to its numerator.
  ///
  /// ROLE_POSTING_VOLUME is postings resolved to this role over postings
  /// that entered role resolution at all, so it reads as "share of
  /// observed postings that were this role". Setting denominator equal to
  /// numerator would make any generic renderer display every volume as
  /// 100%, and would not roll up.
  numeratorCount       Int
  denominatorCount     Int
  /// How concentrated the sample is. Counts distinct
  /// MarketPostingNormalization.companyNormalized at this run's ruleset
  /// version - never the un-versioned copy on MarketPosting. 1 means this
  /// is a statement about one employer, not about a market.
  distinctCompanyCount Int
  distinctSourceCount  Int

  /// Copied from the run so a signal is self-describing when handed around
  /// alone.
  windowStart        DateTime
  windowEnd          DateTime
  rulesetVersion     Int
  computationVersion Int
  sourceScopeKey     String
  /// NONE in Phase 8: cross-source postings are not collapsed, so these
  /// count POSTINGS, never "jobs" or "openings".
  dedupeMethod       MarketDedupeMethod
  coverageComplete   Boolean
  computedAt         DateTime

  run   MarketSignalRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  role  MarketRole      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  skill MarketSkill?    @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@index([runId, signalType])
  @@index([roleId, signalType])
  @@index([skillId])
}

/// Which class of evidence a dataset carries.
///
/// The Market Graph has two irreconcilable shapes. A POSTING is one
/// employer advertising one job, observed by us at a moment we can name.
/// A TAXONOMY term and an AGGREGATE statistic are neither - they are
/// published assertions by an institution about a population, and forcing
/// them into MarketPosting would mean inventing observations that were
/// never made. "47,000 vacancies registered in 2023" is not 47,000 rows.
enum MarketDatasetKind {
  TAXONOMY
  AGGREGATE
}

/// What a taxonomy term denotes.
enum MarketTermKind {
  OCCUPATION
  ALTERNATE_TITLE
  SKILL
  TECHNOLOGY
  INDUSTRY
}

/// One released version of one dataset from one source.
///
/// The unit of provenance for everything in Class B, and the reason there
/// is no table per source: O*NET 31.0, NOC 2021 v1.0, BLS JOLTS and
/// StatCan 14-10-0444 are all rows here, distinguished by data rather than
/// by schema.
///
/// Version is the freshness carrier. A taxonomy has no observedAt - it was
/// not seen, it was published - so "how current is this?" is answered by
/// releasedAt and by whether a newer version exists, never by when we
/// happened to import it.
model MarketDatasetVersion {
  id       String            @id @default(uuid()) @db.Uuid
  sourceId String            @db.Uuid
  kind     MarketDatasetKind

  /// Stable key for the dataset within its source: "onet", "noc",
  /// "jolts", "14-10-0444". Authored, never derived from a label.
  datasetKey String
  /// The publisher's own version string, verbatim: "31.0", "2021-v1.0".
  version    String

  /// When the PUBLISHER released it. Null when the publisher states none.
  releasedAt  DateTime?
  /// When WE fetched it. Deliberately separate: importing today does not
  /// make a 2023 release current, and conflating the two is the exact
  /// fabrication the posting side already forbids.
  retrievedAt DateTime

  /// canonicalHash of the parsed rows, so a re-import of the same
  /// published version is provably the same bytes.
  contentHash String
  rowCount    Int

  /// The attribution string this dataset obliges us to display, stored
  /// with the data rather than in a document, because an obligation that
  /// lives only in documentation is one nobody renders.
  attribution String

  createdAt DateTime @default(now())

  source       MarketSource                 @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  terms        MarketTaxonomyTerm[]
  observations MarketAggregateObservation[]

  @@unique([sourceId, datasetKey, version])
  @@index([sourceId, datasetKey, releasedAt])
}

/// One term from a taxonomy dataset, exactly as the publisher states it.
///
/// Deliberately NOT merged into MarketRole/MarketSkill. Those are the
/// canonical vocabulary this phase authored and controls; these are
/// somebody else's assertions, retained separately so a mapping between
/// them is a reviewable artefact rather than an overwrite. Blindly
/// replacing the canonical vocabulary with 44,779 O*NET titles would
/// destroy every signal already computed against it.
model MarketTaxonomyTerm {
  id               String         @id @default(uuid()) @db.Uuid
  datasetVersionId String         @db.Uuid
  kind             MarketTermKind

  /// The publisher's own code: "15-1252.00", "21231". A STRING, because
  /// NOC codes carry significant leading zeros.
  externalCode String
  label        String
  /// BCP-47. NOC publishes the same code in en and fr.
  language     String
  /// The publisher's own parent code, for hierarchies. Never inferred.
  parentCode   String?

  datasetVersion MarketDatasetVersion @relation(fields: [datasetVersionId], references: [id], onDelete: Cascade)

  @@unique([datasetVersionId, kind, externalCode, label, language])
  @@index([datasetVersionId, kind])
  @@index([externalCode])
}

/// One statistical cell, as published.
///
/// value is a STRING and that is deliberate. These numbers are published
/// by a statistical agency and we must reproduce them exactly; storing
/// 104.3 as a float introduces representation error into a figure we did
/// not compute and cannot recompute. The string is what BLS said. Any
/// arithmetic is the reader's, at the point of use, with the unit in hand.
model MarketAggregateObservation {
  id               String @id @default(uuid()) @db.Uuid
  datasetVersionId String @db.Uuid

  /// The publisher's series or table identifier, verbatim.
  seriesKey String
  /// Publisher's own geography code or label. Not normalized to ours.
  geography String
  /// Publisher's occupation/industry code, when the series carries one.
  category  String?

  /// The period the observation DESCRIBES, which is not when it was
  /// released and not when we fetched it.
  periodStart DateTime
  periodEnd   DateTime
  /// "MONTH", "QUARTER", "YEAR", "WEEK" - the publisher's own cadence.
  periodType  String

  metric String
  value  String
  unit   String

  datasetVersion MarketDatasetVersion @relation(fields: [datasetVersionId], references: [id], onDelete: Cascade)

  @@unique([datasetVersionId, seriesKey, geography, category, periodStart, metric])
  @@index([datasetVersionId, seriesKey])
  @@index([periodStart])
}

/// One row per posting, holding everything Market Search reads.
///
/// A DERIVED PROJECTION over frozen Phase 8/9 evidence, in the same family
/// as MarketSignal: it asserts nothing the underlying tables do not
/// already say, it is rebuilt rather than edited, and deleting every row
/// costs only the time to rebuild them. Search never writes here and never
/// writes anywhere else.
///
/// It exists because the schema genuinely cannot serve search without it,
/// not to make a query tidier. Three reasons, each measured on the current
/// corpus:
///
///   1. There is no "current version" pointer anywhere. A posting's
///      readable content lives on MarketPostingVersion, its role on
///      MarketPostingNormalization at a ruleset version, and its skills on
///      MarketPostingSkillMention one level below that. Ranking a page of
///      results without this table means a window function over 76,968
///      versions joined to two more tables, per request.
///   2. Ranking has to happen in the database. Fetching candidates and
///      scoring them in the application is the N+1 that section 19
///      forbids, and it makes deterministic keyset pagination impossible
///      because page 2 cannot know what page 1 scored.
///   3. Tokens have to be indexable. The tokenizer is Phase 9's, in
///      TypeScript, and Postgres cannot call it - so the tokens are
///      computed once here and GIN-indexed, rather than recomputed per
///      request or approximated by a LIKE scan.
///
/// Every column is a copy of something already stored. The one thing this
/// table adds is the ARRANGEMENT.
model MarketPostingSearchDocument {
  /// The posting this describes. Also the primary key: exactly one
  /// document per posting, so a rebuild cannot silently double a corpus.
  postingId String @id @db.Uuid

  /// Which projection ruleset built this row. Separate from
  /// rulesetVersion because they change for different reasons: adding a
  /// ranking token changes the projection and leaves normalization alone.
  projectionVersion Int
  /// The normalization ruleset this row READ. Recorded so a document
  /// built against a superseded ruleset is identifiable rather than
  /// merely stale-looking.
  rulesetVersion    Int

  /// Denormalized so a source filter needs no join. Not authoritative -
  /// MarketPosting.sourceId is - and never counted from.
  sourceId    String @db.Uuid
  sourceSlug  String
  /// The sub-scope this posting was found in, copied from MarketPosting.
  ///
  /// Here because freshness needs it. The coverage gate asks "has a
  /// COMPLETE read of THIS posting's scope finished since we last saw
  /// it", and that question cannot be answered per source: a run that
  /// completely read four boards and was rate-limited on the fifth
  /// leaves postings on the fifth whose absence is our failure rather
  /// than their disappearance.
  sourceScope String

  /// Which version's content this row projected.
  versionId String @db.Uuid

  /// The posting's opaque market identity, copied verbatim.
  ///
  /// The pagination tie-breaker, and the reason it is here rather than
  /// joined: it is unique, total, and identical in dev, CI and
  /// production, which the uuid primary key is not. An ordering broken by
  /// a uuid would reproduce in-process and differ between environments.
  externalId String

  titleRaw        String
  titleNormalized String
  /// Phase 9's tokenizer, applied once. Never recomputed at read time.
  titleTokens     String[]

  companyRaw        String?
  companyNormalized String?

  /// Free text, and city-level on five of six sources. There is no
  /// location taxonomy here and deliberately none: see the note in
  /// search/search-ruleset.ts.
  locationRaw        String?
  locationNormalized String?
  locationTokens     String[]

  /// The canonical role, as Phase 9 resolved it. Null on 41% of the
  /// corpus, which is a fact about the vocabulary and not a defect here -
  /// a null role means the posting is findable by title and not by role.
  roleSlug String?

  /// Canonical skills mentioned, sorted. Empty on 96% of postings,
  /// because only 13,164 postings carry a description at all.
  skillSlugs String[]

  /// Every token a free-text query may match: title, company, location,
  /// role label and skill labels.
  ///
  /// Description text is deliberately NOT here. It exists on 13,164 of
  /// 76,968 postings, all of them on three of the six sources, so
  /// indexing it would rank a JobTech posting above an identically
  /// relevant Canada Job Bank one for no reason a reader could see - a
  /// systematic bias caused by which publisher happens to ship a body.
  searchTokens String[]

  /// The publisher's claims about time, copied. Never our retrieval time:
  /// a posting fetched today is not newer than one published yesterday.
  sourcePublishedAt  DateTime?
  sourceValidThrough DateTime?
  firstSeenAt        DateTime
  lastSeenAt         DateTime

  applyUrl String?

  /// The source's OWN grouping assertion, copied from
  /// MarketPosting.externalGroupKey.
  ///
  /// Search-time grouping uses (sourceId, groupKey) and nothing else. It
  /// is never inferred from titles, companies or descriptions, because a
  /// grouping we infer is a merge of two jobs we cannot tell apart.
  groupKey String?

  /// canonicalHash of everything this row asserts. Re-projecting must
  /// reproduce it, which is what makes a rebuild idempotent rather than
  /// merely repeatable.
  contentHash String
  projectedAt DateTime

  posting MarketPosting        @relation(fields: [postingId], references: [id], onDelete: Cascade)
  version MarketPostingVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([sourceSlug])
  @@index([roleSlug])
  @@index([companyNormalized])
  @@index([sourcePublishedAt])
  @@index([sourceId, groupKey])
  @@index([versionId])
  @@index([searchTokens], type: Gin)
  @@index([locationTokens], type: Gin)
  @@index([skillSlugs], type: Gin)
}
