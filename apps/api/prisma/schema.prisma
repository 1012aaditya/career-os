datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum ExperienceType {
  EMPLOYMENT
  FOUNDER
  FREELANCE
  EDUCATION
  VOLUNTEER
  OTHER
}

enum ResumeImportStatus {
  PENDING
  PROCESSING
  NEEDS_REVIEW
  CONFIRMED
  FAILED
}

enum EvidenceSourceType {
  MANUAL
  RESUME
  GITHUB
  PORTFOLIO
  LINKEDIN
  CERTIFICATION
  DOCUMENT
  OTHER
}

/// Which external system an ExternalConnection speaks to. Separate from
/// EvidenceSourceType, which describes where a piece of evidence came from:
/// a source can produce evidence without us ever holding a connection to it
/// (RESUME, MANUAL), and a connection is a credential-bearing relationship
/// that only some sources have.
enum ExternalProvider {
  GITHUB
  PORTFOLIO
}

enum ExternalConnectionStatus {
  ACTIVE
  INVALID
  REVOKED
}

/// PARTIAL is not a failure. A sync that read 30 of 40 repositories
/// succeeded at what it did and must not claim the other 10 were empty -
/// see the completeness contract in docs/external-evidence.
enum ExternalSyncStatus {
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
}

model User {
  id        String   @id @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile               Profile?
  experiences           Experience[]
  projects              Project[]
  userSkills            UserSkill[]
  achievements          Achievement[]
  evidence              Evidence[]
  goals                 Goal[]
  resumeImports         ResumeImport[]
  educations            Education[]
  careerGraphIngestions CareerGraphIngestion[]

  externalConnections        ExternalConnection[]
  oauthAuthorizationRequests OAuthAuthorizationRequest[]
  externalSyncRuns           ExternalSyncRun[]
}

model Profile {
  id        String  @id @default(uuid()) @db.Uuid
  userId    String  @unique @db.Uuid
  firstName String?
  lastName  String?
  headline  String?
  bio       String?
  location  String?
  avatarUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Education {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  institution  String
  location     String?
  degree       String?
  fieldOfStudy String?
  startDate    DateTime?
  endDate      DateTime?
  grade        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  evidence EvidenceEducation[]

  @@index([userId])
  @@index([userId, startDate])
}

model Company {
  id             String  @id @default(uuid()) @db.Uuid
  name           String
  normalizedName String  @unique
  websiteUrl     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  experiences Experience[]
}

model ResumeImport {
  id                   String                @id @default(uuid()) @db.Uuid
  userId               String                @db.Uuid
  fileName             String
  storagePath          String
  status               ResumeImportStatus    @default(PENDING)
  /// What the user reviewed and confirmed. Overwritten by their edits.
  extractionResult     Json?
  /// The worker's original output, written once on delivery and never
  /// updated. Without it there is no way to answer what the AI actually
  /// extracted, because extractionResult is replaced by the user's edits
  /// on every confirm. Null for imports ingested before this column
  /// existed - unknown, and not reconstructible.
  rawExtractionResult  Json?
  errorMessage         String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  careerGraphIngestion CareerGraphIngestion?

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  evidence Evidence[]

  @@index([userId])
  @@index([userId, status])
}

model Experience {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String         @db.Uuid
  companyId   String?        @db.Uuid
  type        ExperienceType
  title       String
  description String?
  location    String?
  startDate   DateTime?
  endDate     DateTime?
  /// The end date exactly as the source wrote it, before parsing.
  /// isCurrent alone cannot distinguish a source that SAID "Present" from
  /// one that simply omitted an end date - the first is a fact, the second
  /// an inference. This keeps that distinction recoverable.
  endDateText String?
  isCurrent   Boolean        @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company      Company?                @relation(fields: [companyId], references: [id], onDelete: SetNull)
  projects     ExperienceProject[]
  skills       ExperienceSkill[]
  achievements ExperienceAchievement[]
  evidence     EvidenceExperience[]

  @@index([userId])
  @@index([companyId])
  @@index([userId, startDate])
}

model Project {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  name        String
  description String?
  url         String?
  startDate   DateTime?
  endDate     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  experiences  ExperienceProject[]
  skills       ProjectSkill[]
  achievements ProjectAchievement[]
  evidence     EvidenceProject[]

  @@index([userId])
  @@index([userId, startDate])
}

model Skill {
  id             String @id @default(uuid()) @db.Uuid
  name           String
  normalizedName String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userSkills  UserSkill[]
  experiences ExperienceSkill[]
  projects    ProjectSkill[]
  evidence    EvidenceSkill[]
}

model UserSkill {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  skillId   String   @db.Uuid
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@index([skillId])
}

model Achievement {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  title       String
  description String?
  occurredAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  experiences ExperienceAchievement[]
  projects    ProjectAchievement[]
  evidence    EvidenceAchievement[]

  @@index([userId])
  @@index([userId, occurredAt])
}

model Evidence {
  id             String             @id @default(uuid()) @db.Uuid
  userId         String             @db.Uuid
  resumeImportId String?            @db.Uuid
  sourceType     EvidenceSourceType
  title          String
  description    String?
  sourceUrl      String?
  externalId     String?
  occurredAt     DateTime?
  capturedAt     DateTime           @default(now())
  metadata       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeImport ResumeImport?         @relation(fields: [resumeImportId], references: [id], onDelete: SetNull)
  experiences  EvidenceExperience[]
  projects     EvidenceProject[]
  skills       EvidenceSkill[]
  achievements EvidenceAchievement[]
  educations   EvidenceEducation[]

  /// Deduplication key for re-syncable sources.
  ///
  /// A resume is confirmed once; an external source is pulled again and
  /// again, so re-ingesting must update in place rather than accumulate a
  /// new row per sync. externalId is nullable and Postgres treats NULLs as
  /// DISTINCT, so every existing resume row - all of which carry NULL - is
  /// unaffected and needs no backfill. NULLS NOT DISTINCT would invert
  /// that and is deliberately not used: it would fail on the second resume
  /// evidence row for a user.
  @@unique([userId, sourceType, externalId])
  @@index([userId])
  @@index([userId, sourceType])
  @@index([userId, capturedAt])
  @@index([resumeImportId])
}

model Goal {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  title       String
  description String?
  targetDate  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, targetDate])
}

model CareerGraphIngestion {
  id             String   @id @default(uuid()) @db.Uuid
  resumeImportId String   @unique @db.Uuid
  userId         String   @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  resumeImport ResumeImport @relation(fields: [resumeImportId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ExperienceProject {
  experienceId String @db.Uuid
  projectId    String @db.Uuid

  experience Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([experienceId, projectId])
  @@index([projectId])
}

model ExperienceSkill {
  experienceId String @db.Uuid
  skillId      String @db.Uuid

  experience Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  skill      Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([experienceId, skillId])
  @@index([skillId])
}

model ProjectSkill {
  projectId String @db.Uuid
  skillId   String @db.Uuid

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([projectId, skillId])
  @@index([skillId])
}

model ExperienceAchievement {
  experienceId  String @db.Uuid
  achievementId String @db.Uuid

  experience  Experience  @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@id([experienceId, achievementId])
  @@index([achievementId])
}

model ProjectAchievement {
  projectId     String @db.Uuid
  achievementId String @db.Uuid

  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@id([projectId, achievementId])
  @@index([achievementId])
}

model EvidenceExperience {
  evidenceId   String @db.Uuid
  experienceId String @db.Uuid

  evidence   Evidence   @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  experience Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@id([evidenceId, experienceId])
  @@index([experienceId])
}

model EvidenceProject {
  evidenceId String @db.Uuid
  projectId  String @db.Uuid

  evidence Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([evidenceId, projectId])
  @@index([projectId])
}

model EvidenceSkill {
  evidenceId String @db.Uuid
  skillId    String @db.Uuid

  evidence Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  skill    Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([evidenceId, skillId])
  @@index([skillId])
}

model EvidenceEducation {
  evidenceId  String @db.Uuid
  educationId String @db.Uuid

  evidence  Evidence  @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  education Education @relation(fields: [educationId], references: [id], onDelete: Cascade)

  @@id([evidenceId, educationId])
  @@index([educationId])
}

model EvidenceAchievement {
  evidenceId    String @db.Uuid
  achievementId String @db.Uuid

  evidence    Evidence    @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@id([evidenceId, achievementId])
  @@index([achievementId])
}

/*
 * ------------------------------------------------------------------
 * EXTERNAL EVIDENCE LAYER (Phase 7)
 * ------------------------------------------------------------------
 *
 * These three tables are additive. Nothing above them changes, and in
 * particular CareerGraphIngestion is left exactly as it is: it is keyed to
 * a ResumeImport by a NOT NULL foreign key, and widening that to carry a
 * source with entirely different semantics - a resume is confirmed once, a
 * connection is re-synced forever - would weaken a live invariant to serve
 * a case that a new table serves without touching anything.
 *
 * See docs/external-evidence/phase-7-0-decisions.md.
 */

/// A credential-bearing relationship between one user and one external
/// provider.
///
/// Identity is the provider's IMMUTABLE numeric account id, never the
/// login. GitHub logins are user-changeable and, once released, claimable
/// by somebody else - so resolving a connection by login is a live
/// cross-user data-leak bug, not a style preference. The login is stored
/// for display and refreshed on each sync.
model ExternalConnection {
  id       String           @id @default(uuid()) @db.Uuid
  userId   String           @db.Uuid
  provider ExternalProvider

  /// The provider's immutable numeric account id, held as text so a
  /// provider whose ids are not numeric can reuse this table.
  externalAccountId String
  /// Display only. Mutable at the provider; never used as a lookup key.
  externalAccountLogin String

  /*
   * Token material. Nullable because not every provider is
   * credential-bearing: a PORTFOLIO connection is a public URL and holds
   * no token at all.
   *
   * Encrypted with AES-256-GCM. The AAD binds each ciphertext to the user
   * that owns it, so a row copied into another user's record fails to
   * decrypt rather than silently working - without that, anyone able to
   * UPDATE this table could sync as a victim.
   */
  tokenCiphertext Bytes?
  tokenIv         Bytes?
  tokenTag        Bytes?
  /// Which key encrypted this row. Per-row rather than global so rotation
  /// can re-encrypt lazily instead of in one migration.
  tokenKeyVersion Int?
  tokenAlg        String?

  /// What the provider ACTUALLY granted, which can differ from what was
  /// requested. Checked before calling an endpoint, never assumed.
  grantedScopes String[]

  status ExternalConnectionStatus @default(ACTIVE)

  lastVerifiedAt DateTime?
  lastSyncedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  syncRuns ExternalSyncRun[]

  /// One connection per provider per user.
  @@unique([userId, provider])
  /// One user per external account. This is what caps the blast radius of
  /// an account-linking CSRF: a successful attack becomes a unique-
  /// constraint conflict instead of one attacker account silently
  /// attached to many victims.
  @@unique([provider, externalAccountId])
}

/// A pending OAuth authorization, created before the user is sent to the
/// provider and consumed exactly once when they come back.
///
/// This table is the ONLY thing that answers "which of our users does this
/// callback belong to". The callback arrives in a system browser that
/// carries no session for a bearer-token API, so there is no ambient user
/// to read - which is the correct design, not a limitation. Deriving the
/// owner from a session instead is the account-linking CSRF: an attacker
/// authorizes as themselves, withholds the callback, and induces a
/// logged-in victim to replay it, binding the attacker's provider account
/// to the victim's profile.
model OAuthAuthorizationRequest {
  id       String           @id @default(uuid()) @db.Uuid
  userId   String           @db.Uuid
  provider ExternalProvider

  /// sha256(state), never the state itself. A read-only leak of this table
  /// then yields nothing replayable.
  stateHash String @unique

  /// PKCE verifier, encrypted at rest like any other credential. It is
  /// short-lived, but a verifier in the clear turns a leaked authorization
  /// code back into a redeemable one.
  codeVerifierCiphertext Bytes
  codeVerifierIv         Bytes
  codeVerifierTag        Bytes
  codeVerifierKeyVersion Int

  /// Recorded so the callback can verify the URI it arrived on matches the
  /// one the request went out with.
  redirectUri String
  /// The scope string actually sent. Always sent explicitly: omitting it
  /// makes the provider grant every scope the user ever approved for this
  /// application.
  scope String

  expiresAt  DateTime
  /// Set by an atomic compare-and-swap. A second consumption is an attack
  /// signal, not a retry.
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// The source-generic ingestion ledger: one row per sync attempt.
///
/// stats carries the completeness record - reposScanned, reposTotal and
/// the per-repository markers. A run that read fewer repositories than it
/// found is PARTIAL. It must never be reported as SUCCEEDED, because a
/// repository that was skipped for rate-limit budget is not a repository
/// with no work in it.
model ExternalSyncRun {
  id           String             @id @default(uuid()) @db.Uuid
  connectionId String             @db.Uuid
  userId       String             @db.Uuid
  status       ExternalSyncStatus @default(RUNNING)

  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  errorMessage String?
  stats        Json?

  connection ExternalConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([connectionId, startedAt])
  @@index([userId])
}
