# Everything EXPO_PUBLIC_ is compiled into the app bundle and is readable
# by anyone who has the app. Nothing secret may go here.
#
# The anon key is public BY DESIGN: it grants nothing on its own and is
# what every Supabase client ships with. The SESSION is the secret, and it
# lives in the iOS Keychain rather than AsyncStorage - see
# src/lib/secure-session-storage.ts.
#
# The service-role key must NEVER appear in this file or anywhere in this
# app. If it is here, it is in every user's phone.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Must be https in any real build: iOS App Transport Security blocks plain
# http, and a bearer token must not travel over one regardless.
EXPO_PUBLIC_API_URL=
